# File: .gitignore
# Description: Git ignore rules for an ESP-IDF v5.5 project.

# Build output
build/

# Managed components are downloaded again from dependencies.lock
managed_components/

# Local configuration generated by menuconfig (sdkconfig.defaults IS committed)
sdkconfig
sdkconfig.old

# Private credentials (WiFi, Telegram bot token, etc.)
components/token/include/token.h

# Editor / OS files
.vscode/
.devcontainer/
.cache/
*.code-workspace
.DS_Store
Thumbs.db
