#ifndef __TOKEN_H__
#define __TOKEN_H__

/* WiFi network station credentials */
struct WiFiCredentials {
    const char* ssid;
    const char* pass;
};

extern WiFiCredentials wifiNetworks[];
extern int numNetworks;

/* Telegram bot token (get it from @BotFather) */
#define BOT_TOKEN "PUT_YOUR_BOT_TOKEN_HERE"
#define BOT_ID    "PUT_YOUR_CHAT_ID_HERE"

/* mDNS host name */
#define name_MDNS "ESP32-XXXXXX"

#endif /* __TOKEN_H__ */
